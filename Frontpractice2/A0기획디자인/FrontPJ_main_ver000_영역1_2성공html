    <style>
        body
        {
            margin: 0;
            padding: 0;
        }

        */**/
        { 

        }
        .divc1/*container*/ 
        {
            background-color: black;
            
            margin:0px;
            height:3000px;
            width: 100%;
        }
        .divc2/*header main footer*/
        {
            height: 500px;
            width: 100%;
