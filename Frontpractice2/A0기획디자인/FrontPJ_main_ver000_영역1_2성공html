</head>
<body>
    <div class="divc1" id="container1">
        <header class="divc2">header<div class="divc4" id="logoarea1">logo</div><nav  class="divc4">nav</nav></header>
        <main class="divc2">main
        <aside class="divc3">aside</aside>
        <article class="divc3">
            article
