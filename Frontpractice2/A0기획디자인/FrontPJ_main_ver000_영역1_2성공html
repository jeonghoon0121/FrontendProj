        aside{background-color: orange; order:1;}
        nav{background-color: blue; order:2;}
        main{background-color:aqua; display:flex; width:auto;}
        article{background-color: yellow; order:2;}
        footer{background-color: black;}

        #container1
        {
            /*가운데정렬*/
            width:auto;
        }
        #section1{background-color: blueviolet;}
        #section2{background-color: brown;}
